# ============================================================
#   SISTEM MANAJEMEN KONVEKSI - KONFIGURASI ENVIRONMENT
# ============================================================

# Port aplikasi di komputer klien (default 3001)
PORT=3001

# URL Aplikasi (untuk akses lokal gunakan http://localhost:3001 atau IP LAN)
APP_URL=http://localhost:3001

# Kunci Keamanan Sesi (Opsional, minimal 32 karakter acak. Jika dikosongkan, sistem membuat otomatis di folder data)
AUTH_SECRET=rahasia_konveksi_apps_keamanan_sesi_2026_super_secure

# ── Sistem Lisensi VOC ML ──
STORE_NAME=Konveksi Cabang Utama
VOCML_SERVER_URL=https://vocml.vocpos.id
VOCML_PRODUCT=pos
VOCML_MACHINE_ID=
# Isi true jika ingin menonaktifkan pengecekan lisensi saat uji coba
VOCML_DISABLED=false

# Token Cloudflare Tunnel (Opsional: Hanya diisi jika ingin diakses dari luar kantor via domain vr.vocpos.id)
TUNNEL_TOKEN=

# ── Integrasi Marketplace (Opsional) ──
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SANDBOX=
