    "ioredis": "^6.0.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "uuid": "^14.0.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
