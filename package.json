{
  "name": "konveksi-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.mjs",
    "dev:next": "next dev -p 3001",
    "dev:redis": "REDIS_URL=redis://127.0.0.1:6379 node server.mjs",
    "redis:start": "redis-server --daemonize yes 2>/dev/null || brew services start redis",
    "redis:stop": "redis-cli shutdown nosave 2>/dev/null || brew services stop redis || true",
    "redis:ping": "redis-cli ping",
    "migrate": "node migrate.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "start:next": "next start -p 3001"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
