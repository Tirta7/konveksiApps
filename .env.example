# Salin menjadi .env lalu isi. JANGAN commit / kirim file .env ke siapa pun.

# Alamat publik aplikasi (dipakai untuk redirect OAuth & webhook marketplace)
APP_URL=https://vr.vocpos.id

# Kunci tanda tangan sesi login (min. 32 karakter acak).
# Buat dengan: openssl rand -hex 32
AUTH_SECRET=

# Token Cloudflare Tunnel (Zero Trust → Networks → Tunnels → Install connector → Docker)
TUNNEL_TOKEN=

# ── TikTok Shop / Tokopedia (TikTok Shop Partner Center → App & Service) ──
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=

# ── Shopee Open Platform (Console → App → App Detail) ──
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# true = sandbox (partner.test-stable.shopeemobile.com), kosong/false = live
SHOPEE_SANDBOX=
